# Groq (production — chatbot Gigi, gratuit)
VITE_GROQ_API_KEY=gsk_...
VITE_GROQ_MODEL=llama-3.3-70b-versatile

# Ollama (dev local — fallback si pas de clé Groq)
VITE_OLLAMA_URL=http://localhost:11434
VITE_OLLAMA_MODEL=llama3.2:3b

# ── Gigi : LLM côté serveur (api/chat.ts) ───────────────────────────────
# À définir dans Vercel (Project Settings → Environment Variables) et dans .env
# pour `vercel dev`. SANS préfixe VITE_ : une variable VITE_* est copiée dans le
# JavaScript public du site.
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b   (llama-3.3-70b-versatile = comptes Enterprise seulement)

# En local sans `vercel dev` : utiliser Ollama au lieu de /api/chat
# VITE_CHAT_PROVIDER=ollama
